{
 "segformer": {
  "experiment": "SegFormer-Temporal-Multi15-Baseline",
  "seed": 1234,
  "deterministic": true,
  "output_dir": "outputs/segformer",
  "data": {
   "version": "v6_main",
   "source_root": "data/sen12",
   "cache_dir": "data/s2_10band_v1",
   "manifest": "manifests/official_single/trainval.jsonl",
   "quarantine": "manifests/s2_10band_v1_quarantine.jsonl",
   "stats": "manifests/official_single/stats_train.json",
   "test_event": "italy",
   "val_event": "hiroshima",
   "max_cloud": 0.5,
   "min_valid_ratio": 0.5,
   "max_label_invalid_ratio": 0.6,
   "warn_days_after_event": 365,
   "post_event_window_days": 120,
   "image_size": 128,
   "num_workers": 0,
   "preload": true,
   "test_manifest": "manifests/official_single/test.jsonl",
   "protocol": "manifests/official_single/protocol.json",
   "temporal_root": "data/s2_temporal_v5",
   "quality": "data/s2_temporal_v6_quality"
  },
  "model": {
   "type": "temporal_spectral",
   "backbone": "b0",
   "adapter": "direct10",
   "stem": false,
   "refine": "none",
   "fusion": "sum",
   "fusion_width": 64,
   "pretrained_dir": "weights/segformer/segformer-b0-finetuned-ade-512-512",
   "pretrained_source": "nvidia/segformer-b0-finetuned-ade-512-512",
   "unet": {
    "encoder_name": "resnet18",
    "encoder_weights": "imagenet"
   },
   "spectral": false,
   "spectral_patch": 4,
   "spectral_width": 64,
   "spectral_heads": 4,
   "spectral_layers": 2
  },
  "loss": {
   "bce_weight": 0.5,
   "dice_weight": 0.5,
   "coarse_weight": 0.0,
   "boundary_weight": 0.0,
   "boundary_width": 2
  },
  "optim": {
   "encoder_lr": 6e-05,
   "head_lr": 0.0006,
   "first_conv_lr": null,
   "weight_decay": 0.01,
   "grad_clip": 1.0,
   "warmup_frac": 0.05,
   "schedule": "poly",
   "poly_power": 1.0
  },
  "sampling": {
   "mode": "natural",
   "event_power": 0.5,
   "scale_power": 0.5,
   "max_weight": 4.0
  },
  "train": {
   "epochs": 150,
   "batch_size": 64,
   "amp": false,
   "amp_dtype": "bf16",
   "log_every": 20,
   "max_steps": 3600,
   "microbatch": 8,
   "accumulation": 8,
   "eval_every_updates": 100,
   "budget_mode": "updates"
  },
  "eval": {
   "threshold": 0.5,
   "scale_thresholds_ha": [
    0.5,
    2.0
   ],
   "object_iou_threshold": 0.25,
   "object_iou_strict": 0.5,
   "boundary_tol_px": 1,
   "batch_size": 8,
   "selection_metric": "dev_pooled_iou"
  },
  "temporal": {
   "mode": "multi"
  }
 }
}