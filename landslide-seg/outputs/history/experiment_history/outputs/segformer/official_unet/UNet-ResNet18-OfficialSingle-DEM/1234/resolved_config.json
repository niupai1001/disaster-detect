   "quarantine": "manifests/official_single/exclusions.jsonl",
   "stats": "manifests/official_single_geo/stats_dem.json",
   "test_event": "italy",
   "val_event": "hiroshima",
   "max_cloud": 0.5,
   "min_valid_ratio": 0.5,
   "max_label_invalid_ratio": 0.6,
   "warn_days_after_event": 365,
