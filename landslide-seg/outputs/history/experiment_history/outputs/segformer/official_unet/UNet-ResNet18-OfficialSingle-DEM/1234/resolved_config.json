   "unet": {
    "encoder_name": "resnet18",
    "encoder_weights": "imagenet"
   },
   "in_chans": 11,
   "band_order": [
    "B02",
    "B03",
    "B04",
    "B05",
    "B06",
    "B07",
    "B08",
    "B8A",
    "B11",
    "B12",
    "DEM"
   ],
   "extra_channel": "dem"
  },
  "loss": {
