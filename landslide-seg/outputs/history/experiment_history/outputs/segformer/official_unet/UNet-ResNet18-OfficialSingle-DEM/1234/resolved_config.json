{
 "segformer": {
  "experiment": "UNet-ResNet18-OfficialSingle-DEM",
  "seed": 1234,
  "deterministic": true,
  "output_dir": "outputs/segformer",
  "data": {
   "version": "official_unet",
   "source_root": "data/sen12",
   "cache_dir": "data/s2_official_single_geo",
