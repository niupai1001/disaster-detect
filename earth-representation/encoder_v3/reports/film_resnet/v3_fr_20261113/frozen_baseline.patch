+def texture_mse(sample, result):
+    """Gradient MSE on the upper quartile of truth contrast across adjacent hidden pairs."""
+    offset = 0
+    metrics = []
+    for channel, target in zip(sample.channels, result.targets):
+        n = int(target.sum())
+        predicted = channel.values.new_zeros(channel.values.shape)
+        predicted[target] = result.predictions[offset:offset+n]
+        offset += n
+        truth = channel.values
+        for axis in (0, 1):
+            valid = (target[:-1] & target[1:]) if axis == 0 else (target[:, :-1] & target[:, 1:])
+            if bool(valid.any()):
+                detail = truth.diff(dim=axis)[valid]
+                error = predicted.diff(dim=axis)[valid]-detail
+                strong = detail.abs() >= torch.quantile(detail.abs(), .75)
+                metrics.append(float(error[strong].square().mean()))
+    return statistics.mean(metrics) if metrics else None
