+def validate_early_stop(policy):
+    if policy is None:
+        return
+    if (not isinstance(policy, dict) or not {"patience", "min_delta"} <= set(policy)
+            or set(policy) - {"patience", "min_delta", "relative"}
+            or type(policy.get("relative", False)) is not bool
+            or type(policy["patience"]) is not int or policy["patience"] < 1
+            or type(policy["min_delta"]) not in (int, float)
+            or not math.isfinite(policy["min_delta"]) or policy["min_delta"] < 0):
+        raise ValueError("Early stopping needs positive integer patience and finite nonnegative min_delta")
+
+
+def update_early_stop(state, policy, epoch, metric):
+    if policy is None or epoch == 0:
+        return
+    current = state.setdefault("early_stopping", dict(reference=None, bad_epochs=0))
+    reference = current["reference"]
+    threshold = policy["min_delta"] * (abs(reference) if policy.get("relative") and reference is not None else 1.)
+    if reference is None or (metric < reference and reference - metric >= threshold):
+        current.update(reference=metric, reference_epoch=epoch, bad_epochs=0)
+    else:
+        current["bad_epochs"] += 1
+    current["triggered"] = current["bad_epochs"] >= policy["patience"]
