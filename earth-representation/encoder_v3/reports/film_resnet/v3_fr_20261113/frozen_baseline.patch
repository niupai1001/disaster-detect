+"""Exact rectangular ownership overlaps for stride-4 native patch tokens."""
+from dataclasses import dataclass
+from functools import lru_cache
+
+import numpy as np
+import torch
+
+STRIDE = 4
+
+
+def ownership_edges(size):
+    """Midpoints between convolution centres, clipped to the native footprint."""
+    count = (size + STRIDE - 1) // STRIDE
+    return np.r_[0., .5 + STRIDE * (np.arange(1, count) - .5), float(size)]
+
+
+@dataclass(frozen=True)
+class PatchMap:
+    source: torch.Tensor
+    destination: torch.Tensor
+    area: torch.Tensor
+    footprint: torch.Tensor
+    shape: tuple
+    slots: int
+
+    def align(self, feature, coverage):
+        """Area × visible receptive-field fraction; one aligned feature per band and cell."""
+        channels, _, width = feature.shape
+        total = feature.new_zeros(channels, self.slots, width)
+        support = feature.new_zeros(channels, self.slots)
+        for start in range(0, len(self.source), max(1, 131072 // channels)):
+            stop = start + max(1, 131072 // channels)
+            src, dst = self.source[start:stop], self.destination[start:stop]
+            weights = coverage[:, src] * self.area[start:stop]
+            total.index_add_(1, dst, feature[:, src] * weights[..., None])
+            support.index_add_(1, dst, weights)
+        denominator = torch.where(support > 0, support, 1.)
+        return total / denominator[..., None], support
+
+
+def patch_map(grid, geometry, device):
+    a, _, x, _, e, y = grid.affine
+    offset = (x - geometry.origin[0], y - geometry.origin[1])
+    return _patch_map(grid.shape, a, e, offset, geometry.shape, geometry.patch_size, str(device))
+
+
+@lru_cache(maxsize=16)
+def _patch_map(native_shape, a, e, offset, shape, step, device):
+    h, w = native_shape
+    xe = offset[0] + ownership_edges(w) * a
