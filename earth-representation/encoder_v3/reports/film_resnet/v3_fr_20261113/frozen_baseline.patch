+"""Split observations between two GPUs, preserving one global optimizer update."""
+from concurrent.futures import ThreadPoolExecutor, wait
+import copy
+
+import torch
+
+from encoder_v3.hierarchical.parallel import add_replica_gradients, device_context, partition_rows, synchronize
+from encoder_v3.hierarchical_revised.train import accumulate_observations
+from encoder_v3.shared_mae.data import load_data
+from .batching import timed_partition
+
+
+class ParallelBatch:
+    def __init__(self, model, dataset, resolver, settings, devices, *, secondary_data=None):
+        self.model = model
+        self.devices = tuple(devices)
+        self.replica = copy.deepcopy(model).to(devices[1])
+        self.settings = settings
+        if secondary_data is None:
+            datasets, other_resolver = load_data()
+            other = datasets["TRAIN"]
+        else:
+            other, other_resolver = secondary_data
+        if ([r["id"] for r in dataset.rows] != [r["id"] for r in other.rows]
+                or dataset.identities != other.identities
+                or resolver.catalog_sha != other_resolver.catalog_sha):
+            raise ValueError("Dual-GPU inputs differ from the primary data binding")
+        self.datasets = dataset, other
+        self.resolvers = resolver, other_resolver
+        self.lookups = tuple({r["id"]: i for i, r in enumerate(ds.rows)} for ds in self.datasets)
+        self.pool = ThreadPoolExecutor(max_workers=2, thread_name_prefix="patch-gpu")
+
+    def backward(self, rows, epoch, stopped):
+        self.replica.load_state_dict(self.model.state_dict())
+        self.replica.train(self.model.training)
+        self.replica.zero_grad(set_to_none=True)
+        synchronize(self.devices[1])
+        costs = self.settings.get('device_costs')
+        shards = timed_partition(rows, costs) if costs is not None else partition_rows(rows)
+
+        def work(slot):
+            device = self.devices[slot]
+            model = (self.model, self.replica)[slot]
+            with device_context(device), torch.enable_grad():
+                part = accumulate_observations(model, self.datasets[slot], shards[slot], self.lookups[slot],
+                                               self.resolvers[slot], dict(self.settings, device=device),
+                                               epoch, stopped, prefetch=True)
+                synchronize(device)
+                for record in part:
+                    record['device'] = str(device)
+                return part
+
+        jobs = [self.pool.submit(work, slot) for slot in range(2)]
+        wait(jobs)
+        parts = [job.result() for job in jobs]
+        by_id = {r["id"]: r for part in parts for r in part}
+        if len(by_id) != len(rows):
+            raise ValueError("Global batch was not processed exactly once")
+        add_replica_gradients(self.model, self.replica)
+        synchronize(self.devices[0])
+        return [by_id[r["id"]] for r in rows]
+
+    def close(self):
+        self.pool.shutdown(wait=True, cancel_futures=True)
