+"""Pre-captured spatial pyramids; no capture while the two training workers run."""
+from collections import Counter
+import gc
+from types import SimpleNamespace
+import torch
+from torch import nn
+from torch.nn import functional as F
+from encoder_v3.latent_response.types import NativeGrid
+from encoder_v3.shared_mae.geometry import metric_geometry
+
+
+class SpatialPyramid(nn.Module):
+    def __init__(self, encoder, decoder):
+        super().__init__()
+        self.stages, self.merges = encoder.stages, encoder.merges
+        self.decoder = decoder
+
+    def forward(self, feature, footprint):
+        output, supports = [], []
+        for index, blocks in enumerate(self.stages):
+            if index:
+                footprint = F.max_pool2d(footprint.float(), 3, stride=2, padding=1) > 0
+                feature = torch.where(footprint, self.merges[index-1](feature), 0.)
+            for block in blocks:
+                feature = block(feature, footprint)
+            output.append(feature)
+            supports.append(footprint)
+        field = self.decoder.subcells(SimpleNamespace(features=output, support=supports))
+        return (*output, field)
+
+
+def common_shapes(rows, metres, count=24, max_tokens=16384):
+    counts = Counter()
+    for row in rows:
+        channels = [SimpleNamespace(grid=NativeGrid(tuple(b['transform']), tuple(b['shape']), b['crs']))
+                    for b in row['bands']]
+        shape = metric_geometry(channels, metres).shape
+        counts[shape] += 1
+    shapes = [shape for shape, _ in counts.most_common() if shape[0]*shape[1] <= max_tokens][:count]
+    return shapes, dict(covered=sum(counts[s] for s in shapes), total=len(rows), shapes=[list(s) for s in shapes])
+
+
+def prepare_spatial_graphs(model, shapes):
+    encoder = model.encoder
+    if getattr(encoder, '_spatial_graphs', None):
+        raise ValueError('Spatial graphs already prepared')
+    device = next(model.parameters()).device
+    if device.type != 'cuda':
+        raise ValueError('CUDA graphs require a CUDA device')
+    graphs = {}
+    with torch.cuda.device(device), torch.enable_grad():
+        # Installed PyTorch uses a process-wide default capture stream, even across devices.
+        previous = torch.cuda.graph.default_capture_stream
+        torch.cuda.graph.default_capture_stream = torch.cuda.Stream(device=device)
+        gc.collect()
+        try:
+            with torch.compiler.config.patch(force_cudagraph_gc=False):
+                for height, width in shapes:
+                    module = SpatialPyramid(encoder, model.decoder)
+                    feature = torch.zeros(1, encoder.config.widths[0], height, width, device=device, requires_grad=True)
+                    support = torch.ones(1, 1, height, width, device=device, dtype=torch.bool)
+                    graphs[(height, width)] = torch.cuda.make_graphed_callables(module, (feature, support), num_warmup_iters=3,
+                                                                             allow_unused_input=True)
+        finally:
+            torch.cuda.graph.default_capture_stream = previous
+        # Graph outputs alias its memory pool; accumulated parameter gradients must own storage.
+        encoder._graph_gradient_hooks = [p.register_hook(
+            lambda g, p=p: g.clone() if g is not None and p.grad is None else g)
+                                        for p in SpatialPyramid(encoder, model.decoder).parameters()]
+    encoder._spatial_graphs = graphs
+    model.zero_grad(set_to_none=True)
