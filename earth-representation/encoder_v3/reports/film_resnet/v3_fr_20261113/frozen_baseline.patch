+def cost(config, metrics):
+    stage_macs, merge_macs = [], []
+    for i, (_, width, h, w) in enumerate(metrics["stage_shapes"]):
+        q = math.ceil(h/config.window)*math.ceil(w/config.window)*config.window**2
+        k = q // config.spatial_reduction**2
+        depth = config.depths[i]
+        projection = 2*(q+k)*width**2*depth
+        attention = 2*metrics["stage_pairs"][i]*width
+        ffn = h*w*(4*width**2+18*width)*depth
+        stage_macs.append(projection+attention+ffn)
+        if i:
+            merge_macs.append(h*w*9*width*config.widths[i-1])
+    projections = (metrics["spectral_channel_positions"]*(config.patch_width+1)
+                   + metrics["spectral_descriptor_projections"]*config.descriptor)*config.latent_width
+    if config.spectral == "attention":
+        projections *= 2
+    return dict(stage_macs=stage_macs, merge_macs=merge_macs,
+                spectral_kv_macs=projections,
+                spectral_score_value_macs=2*metrics["spectral_pairs"]*config.latent_width)
