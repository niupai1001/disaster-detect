+"""Freeze, preflight and run the paired one-epoch backbone experiment."""
+import ssl
+import argparse
+from collections import Counter, defaultdict
+import gc
+import json
+import math
+from pathlib import Path
+import random
+import shutil
+import sys
+import time
+import uuid
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+
+import numpy as np
+import torch
+import torchvision
+import transformers
+
+from encoder_v3.data import sha256
+from encoder_v3.hierarchical_revised.backbone_ab import BackboneAB
+from encoder_v3.hierarchical_revised.tasks import available_tasks, task_masks
+from encoder_v3.hierarchical_revised.train import evaluate, save, update
+from encoder_v3.latent_response.checkpoint import digest, parameter_sha
+from encoder_v3.latent_response.run_control import append_event
+from encoder_v3.shared_mae.data import EpochPlan, identity as data_identity, load_data, sample_from_dataset
+from encoder_v3.shared_mae.geometry import AreaCache
+from encoder_v3.shared_mae.train import StopRequested, write
+
+ARMS = ("resnet50", "segformer_b0")
+
+
+def read(path):
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def freeze(output):
+    output.mkdir(parents=True)
+    runtime = output / "runtime"
+    source = ROOT / "src/encoder_v3"
+    paths = list(source.glob("*.py"))
+    for folder in ("shared_mae", "latent_response", "hierarchical", "hierarchical_revised"):
+        paths.extend((source / folder).glob("*.py"))
+    paths.extend(ROOT / p for p in (
+        "scripts/run_encoder_backbone_ab.py", "scripts/train_v3_h_revised.py",
+        "src/encoder_v3/config_optical_selfsup_v1.json", "configs/config_lr_e0_v1.json",
+        "outputs/encoder_v3/latent_response/channel_catalog_frozen.json",
+        "data/physics/sensor_physics.json"))
+    manifest = {}
+    for path in paths:
+        rel = path.relative_to(ROOT)
+        destination = runtime / rel
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(path, destination)
+        manifest[rel.as_posix()] = sha256(destination)
+    for arm in ARMS:
+        shutil.copy2(ROOT / "configs" / f"config_backbone_ab_{arm}.json", output / f"{arm}.json")
+    write(output / "source_manifest.json", manifest)
+
+
+def initialize(arm, settings, cache):
+    seed = settings["seed"]
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    return BackboneAB(arm, cache).to(settings["device"])
+
+
+def largest_indices(dataset):
+    largest = {}
+    for i, row in enumerate(dataset.rows):
+        size = sum(math.prod(band["shape"]) for band in row["bands"])
+        candidate = (size, row["id"], i)
+        if row["sensor"] not in largest or candidate > largest[row["sensor"]]:
+            largest[row["sensor"]] = candidate
+    return {sensor: row[2] for sensor, row in sorted(largest.items())}
+
+
+def preflight(output, configs, dataset, resolver, cache, stopped):
+    records = []
+    for arm in ARMS:
+        settings = configs[arm]["training"]
+        device = settings["device"]
+        model = initialize(arm, settings, cache)
+        for sensor, i in largest_indices(dataset).items():
+            if stopped():
+                raise StopRequested()
+            sample = sample_from_dataset(dataset, i, resolver, device)
+            for kind in available_tasks(sample, model.config):
+                write(output / "status.json", dict(status="PREFLIGHT", arm=arm, sensor=sensor,
+                                                  member=sample.identifier, task=kind))
+                torch.cuda.reset_peak_memory_stats(device)
+                start = time.perf_counter()
+                model.zero_grad(set_to_none=True)
+                with torch.autograd.graph.save_on_cpu():
+                    result = model(sample, kind=kind, seed=settings["seed"])
+                targets = task_masks(sample, model.config, kind, settings["seed"], 0)[1]
+                if not all(torch.equal(a, b) for a, b in zip(result.targets, targets)):
+                    raise ValueError("Target masks changed")
+                if not torch.isfinite(result.loss):
+                    raise ValueError("Nonfinite preflight loss")
+                result.loss.backward()
+                norm = float(torch.nn.utils.clip_grad_norm_(model.parameters(), float("inf"),
+                                                           error_if_nonfinite=True))
+                record = dict(arm=arm, sensor=sensor, id=sample.identifier, task=kind,
+                              targets=len(result.predictions), loss=float(result.loss.detach()),
+                              gradient_norm=norm, seconds=time.perf_counter()-start,
+                              peak_allocated_bytes=torch.cuda.max_memory_allocated(device),
+                              peak_reserved_bytes=torch.cuda.max_memory_reserved(device))
+                records.append(record)
+                write(output / "preflight_progress.json", records)
+                print("PREFLIGHT", record, flush=True)
+                del result
+            del sample
+        del model
+        gc.collect()
+        torch.cuda.empty_cache()
+    write(output / "preflight.json", dict(status="PASS", records=records))
+
+
+def validation(model, dataset, resolver, settings, run, phase, stopped, progress):
+    start = time.perf_counter()
+    report = evaluate(model, dataset, resolver, settings, stopped,
+                      lambda extra: progress(phase, **extra))
+    report["seconds"] = time.perf_counter()-start
+    grouped = defaultdict(list)
+    for member in report["members"]:
+        for task, value in member["tasks"].items():
+            for channel, mse in value["channel_mse"].items():
+                grouped[(member["sensor"], task, channel)].append(mse)
+    report["bands"] = [dict(sensor=sensor, task=task, band=band, eligible=len(values),
+                            mse=sum(values)/len(values))
+                       for (sensor, task, band), values in sorted(grouped.items())]
+    if Counter(m["id"] for m in report["members"]) != Counter(r["id"] for r in dataset.rows):
+        raise ValueError("Incomplete VAL coverage")
+    write(run / f"{phase}.json", report)
+    return report
+
+
+def train_arm(output, config, datasets, resolver, cache, stopped):
+    arm, settings = config["backbone"], config["training"]
+    device = settings["device"]
+    run = output / arm
+    run.mkdir()
+    write(run / "config.json", config)
+    binding = data_identity(config, datasets, resolver)
+    binding.update(architecture=config["architecture"], backbone=arm, frozen_source=digest(read(output / "source_manifest.json")))
+    write(run / "identity.json", binding)
+    model = initialize(arm, settings, cache)
+    optimizer = torch.optim.AdamW(model.parameters(), lr=settings["lr"],
+                                  weight_decay=settings["weight_decay"])
+    dataset = datasets["TRAIN"]
+    plan = EpochPlan(dataset.rows, settings["seed"], settings["batch_size"])
+    lookup = {r["id"]: i for i, r in enumerate(dataset.rows)}
+    state = dict(run_id=uuid.uuid4().hex, arm=arm, cursor=0, spent_updates=0, epoch=0,
+                 observations_seen=0, total_batches=len(plan),
+                 parameters=sum(p.numel() for p in model.parameters()),
+                 initial_parameter_sha=parameter_sha(model))
+    def progress(phase, **extra):
+        report = dict(state, status=phase, **extra)
+        write(run / "status.json", report)
+        write(output / "status.json", report)
+
+    save(run / "initial.pt", model, optimizer, state, binding)
+    torch.cuda.reset_peak_memory_stats(device)
+    initial = validation(model, datasets["VAL"], resolver, settings, run,
+                         "initial_validation", stopped, progress)
+    if parameter_sha(model) != state["initial_parameter_sha"]:
+        raise ValueError("Initial validation changed model state")
+    model.train()
+    start = time.perf_counter()
+    updates_seconds = 0.
+    first42_seconds = None
+    observed = Counter()
+    while state["cursor"] < len(plan):
+        if stopped():
+            raise StopRequested()
+        rows = plan.batch(state["cursor"])
+        batch_start = time.perf_counter()
+        record = update(model, dataset, rows, lookup, resolver, optimizer, state, settings,
+                        len(plan), run, stopped, lambda extra: progress("TRAINING", **extra))
+        record["seconds"] = time.perf_counter()-batch_start
+        updates_seconds += record["seconds"]
+        observed.update(m["id"] for m in record["members"])
+        append_event(run / "updates.jsonl", record)
+        save(run / "last.pt", model, optimizer, state, binding)
+        if state["cursor"] == 42:
+            first42_seconds = time.perf_counter()-start
+        progress("TRAINING")
+        print(arm, "UPDATE", state["cursor"], "/", len(plan), record["loss"], record["seconds"], flush=True)
+    if observed != Counter(lookup.keys()):
+        raise ValueError("Incomplete TRAIN coverage")
+    training_seconds = time.perf_counter()-start
+    final = validation(model, datasets["VAL"], resolver, settings, run,
+                       "final_validation", stopped, progress)
+    state.update(status="COMPLETE", training_seconds=training_seconds,
+                 updates_seconds=updates_seconds, first42_training_seconds=first42_seconds,
+                 initial_validation_seconds=initial["seconds"], final_validation_seconds=final["seconds"],
+                 initial_tasks=initial["tasks"], final_tasks=final["tasks"],
+                 peak_allocated_bytes=torch.cuda.max_memory_allocated(device),
+                 peak_reserved_bytes=torch.cuda.max_memory_reserved(device),
+                 final_parameter_sha=parameter_sha(model))
+    save(run / "last.pt", model, optimizer, state, binding)
+    write(run / "status.json", state)
+    return state
+
+
+def matched_prefix(output, baseline):
+    def records(path):
+        return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines()][:42]
+    reference = records(baseline)
+    def signature(rows):
+        return [[(m["id"], {k: v["targets"] for k, v in m["tasks"].items()})
+                 for m in row["members"]] for row in rows]
+    if len(reference) != 42:
+        raise ValueError("Expected 42 paused V3-H-R batches")
+    times = {"v3_h_r": sum(r["seconds"] for r in reference)}
+    for arm in ARMS:
+        rows = records(output / arm / "updates.jsonl")
+        if signature(rows) != signature(reference):
+            raise ValueError("First-42 member order or target counts differ")
+        times[arm] = sum(r["seconds"] for r in rows)
+    return times
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--baseline-updates", type=Path)
+    parser.add_argument("--prepare", action="store_true")
+    args = parser.parse_args()
+    output = args.output.resolve()
+    if args.prepare:
+        freeze(output)
+        return
+    if not args.baseline_updates or ROOT != output / "runtime":
+        parser.error("Run from the frozen runtime with the paused baseline updates")
+    if (output / "status.json").exists():
+        parser.error("This paired release has already been started")
+    manifest = read(output / "source_manifest.json")
+    if any(sha256(ROOT / name) != expected for name, expected in manifest.items()):
+        raise ValueError("Frozen runtime files changed")
+    configs = {arm: read(output / f"{arm}.json") for arm in ARMS}
+    settings = configs[ARMS[0]]["training"]
+    if any(c["training"] != settings or c["backbone"] != arm for arm, c in configs.items()):
+        raise ValueError("Backbone comparison requires identical training settings")
+    if settings["epochs"] != 1 or settings["precision"] != "float32" or settings["optimizer"] != "AdamW":
+        raise ValueError("Expected the approved one-epoch FP32 AdamW budget")
+    if any((c["grid_metres"], c["mask_patch_metres"], c["mask_ratio"]) != (32, 128, .55)
+           for c in configs.values()):
+        raise ValueError("Expected 32 m input and the frozen A mask settings")
+    torch.cuda.set_device(settings["device"])
+    torch.set_num_threads(settings["threads"])
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    torch.backends.cudnn.benchmark = False
+    cache = AreaCache()
+    write(output / "environment.json", dict(torch=torch.__version__, torchvision=torchvision.__version__,
+          transformers=transformers.__version__, gpu=torch.cuda.get_device_name(settings["device"])))
+    stopped = lambda: (output / "STOP_REQUESTED").exists()
+    try:
+        write(output / "status.json", dict(status="LOADING"))
+        datasets, resolver = load_data()
+        if (len(datasets["TRAIN"].rows), len(datasets["VAL"].rows)) != (7442, 383):
