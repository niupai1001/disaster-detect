+        preflight(output, configs, datasets["TRAIN"], resolver, cache, stopped)
+        results = {}
+        for arm in ARMS:
+            results[arm] = train_arm(output, configs[arm], datasets, resolver, cache, stopped)
+            gc.collect()
+            torch.cuda.empty_cache()
+        report = dict(status="COMPLETE", results=results,
+                      first42_update_seconds=matched_prefix(output, args.baseline_updates),
+                      baseline_updates_sha256=sha256(args.baseline_updates))
+        write(output / "comparison.json", report)
+        write(output / "status.json", report)
+    except StopRequested:
+        write(output / "status.json", dict(read(output / "status.json"), status="STOPPED"))
+    except Exception as error:
+        write(output / "status.json", dict(read(output / "status.json"), status="FAILED", error=repr(error)))
+        raise
+
+
+if __name__ == "__main__":
+    main()
