+"""A/B1 on a shared 32 m grid, with either ResNet50 or MiT-B0."""
+from collections import defaultdict
+from dataclasses import dataclass
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+from torch.utils.checkpoint import checkpoint
+
+from encoder_v3.shared_mae.geometry import metric_geometry
+from .frontend import Descriptor, NativeConvolution
+from .tasks import task_masks
+
+
+WIDTH = 32
+GRID_METRES = 32
+BLOCK_PIXELS = 262144
+
+
+@dataclass(frozen=True)
+class MaskConfig:
+    mask_patch_metres: float = 128.
+    mask_ratio: float = .55
+
+
+@dataclass
+class Result:
+    loss: torch.Tensor
+    channel_loss: dict
+    predictions: torch.Tensor
+    targets: tuple
+
+
+class ResNetStages(nn.Module):
+    widths = (256, 512, 1024, 2048)
+
+    def __init__(self):
+        super().__init__()
+        from torchvision.models import resnet50
+
+        self.net = resnet50(weights=None)
+        self.net.conv1 = nn.Conv2d(WIDTH, 64, 7, stride=2, padding=3, bias=False)
+        nn.init.kaiming_normal_(self.net.conv1.weight, mode="fan_out", nonlinearity="relu")
+        del self.net.fc, self.net.avgpool
+
+    def forward(self, x):
+        net = self.net
+        x = net.maxpool(net.relu(net.bn1(net.conv1(x))))
+        stages = []
+        for layer in (net.layer1, net.layer2, net.layer3, net.layer4):
+            x = layer(x)
+            stages.append(x)
+        return stages
+
+
+class MiTStages(nn.Module):
+    widths = (32, 64, 160, 256)
+
+    def __init__(self):
+        super().__init__()
+        from transformers import SegformerConfig, SegformerModel
+
+        self.net = SegformerModel(SegformerConfig(
+            num_channels=WIDTH, hidden_sizes=list(self.widths), depths=[2, 2, 2, 2],
+            num_attention_heads=[1, 2, 5, 8], sr_ratios=[8, 4, 2, 1],
+            patch_sizes=[7, 3, 3, 3], strides=[4, 2, 2, 2],
+            mlp_ratios=[4, 4, 4, 4], drop_path_rate=.1,
+        ))
+
+    def forward(self, x):
+        return self.net(x, output_hidden_states=True).hidden_states
+
+
+def groups_by_grid(channels, flags):
+    groups = defaultdict(list)
+    for index, (channel, active) in enumerate(zip(channels, flags)):
+        if active:
+            groups[channel.grid].append(index)
+    return groups.items()
+
+
+def blocks(indices, pixels):
+    count = max(1, BLOCK_PIXELS // pixels)
+    for start in range(0, len(indices), count):
+        yield indices[start:start+count]
+
+
+def area_features(values, keep, kernels, biases, mapping):
+    """Sum across channels before area scatter, which is linear in each channel."""
+    count, height, width = values.shape
+    clean = torch.where(keep, values, 0.)
+    rows = max(1, min(128, BLOCK_PIXELS // (width * count)))
+    tiles = []
+    for start in range(0, height, rows):
+        end = min(start + rows, height)
+        lo, hi = max(0, start-1), min(height, end+1)
+        feature = F.conv2d(clean[None, :, lo:hi], kernels.flatten(0, 1),
+                           biases.flatten(), padding=1, groups=count)
+        feature = F.gelu(feature.reshape(count, WIDTH, hi-lo, width)
+                         [:, :, start-lo:end-lo])
+        tiles.append(torch.where(keep[:, None, start:end], feature, 0.).sum(0))
+    native = torch.cat(tiles, dim=1).flatten(1).T
+    valid_count = keep.sum(0).flatten().to(values.dtype)
+    total = values.new_zeros(mapping.slots, WIDTH)
+    support = values.new_zeros(mapping.slots)
+    for start in range(0, len(mapping.source), BLOCK_PIXELS):
+        sl = slice(start, start+BLOCK_PIXELS)
+        src, dst, area = mapping.source[sl], mapping.destination[sl], mapping.area[sl].to(values.dtype)
+        total.index_add_(0, dst, native[src] * area[:, None])
+        support.index_add_(0, dst, valid_count[src] * area)
+    return total, support
+
+
+class BackboneAB(nn.Module):
+    def __init__(self, backbone, area_cache):
+        super().__init__()
+        self.config = MaskConfig()
+        self.area_cache = area_cache
+        self.descriptor = Descriptor(WIDTH)
+        self.native = NativeConvolution(WIDTH, WIDTH, 8)
+        self.readout = nn.Linear(WIDTH, WIDTH+1)
+        self.backbone = {"resnet50": ResNetStages, "segformer_b0": MiTStages}[backbone]()
+        self.project = nn.ModuleList(nn.Conv2d(size, WIDTH, 1) for size in self.backbone.widths)
+
+    def common_grid(self, channels, keeps, descriptor, geometry, maps):
+        height, width = geometry.shape
+        total = descriptor.new_zeros(height*width, WIDTH)
+        support = descriptor.new_zeros(height*width)
+        flags = torch.stack([keep.any() for keep in keeps]).tolist()
+        kernels, biases = self.native.generator(descriptor)
+        for grid, indices in groups_by_grid(channels, flags):
+            mapping = maps[grid]
+            for chosen in blocks(indices, mapping.pixels):
+                values = torch.stack([channels[i].values for i in chosen])
+                keep = torch.stack([keeps[i] for i in chosen])
+                args = (values, keep, kernels[chosen], biases[chosen], mapping)
+                if torch.is_grad_enabled() and values.numel() >= BLOCK_PIXELS:
+                    contribution, area = checkpoint(area_features, *args, use_reentrant=False)
+                else:
+                    contribution, area = area_features(*args)
+                total = total + contribution
+                support = support + area
+        denominator = torch.where(support > 0, support, 1.)
+        return (total / denominator[:, None]).T.reshape(1, WIDTH, height, width)
+
+    def forward(self, sample, *, kind, seed, epoch=0):
+        channels = sample.channels
+        keeps, targets = task_masks(sample, self.config, kind, seed, epoch)
+        geometry = metric_geometry(channels, GRID_METRES)
+        device = channels[0].values.device
+        maps = {grid: self.area_cache.get(grid, geometry, 1, device)
+                for grid in dict.fromkeys(geometry.grids)}
+        descriptor = self.descriptor([channel.physical for channel in channels])
+        common = self.common_grid(channels, keeps, descriptor, geometry, maps)
+        height, width = geometry.shape
+        ph, pw = (max(64, (size+31)//32*32) for size in geometry.shape)
+        stages = self.backbone(F.pad(common, (0, pw-width, 0, ph-height)))
+        size = stages[0].shape[-2:]
+        features = torch.stack([
+            F.interpolate(project(stage), size=size, mode="bilinear", align_corners=False)
+            for project, stage in zip(self.project, stages)
+        ]).mean(0)
+        weights, bias = self.readout(descriptor).split((WIDTH, 1), dim=-1)
+        predictions, losses = {}, {}
+        flags = torch.stack([target.any() for target in targets]).tolist()
+        for grid, indices in groups_by_grid(channels, flags):
+            mapping = maps[grid]
+            for chosen in blocks(indices, mapping.pixels):
+                logits = torch.einsum("cd,bdhw->bchw", weights[chosen], features)
+                logits = logits + bias[chosen][None, :, :, None]
+                field = F.interpolate(logits, size=(ph, pw), mode="bilinear",
+                                      align_corners=False)[0, :, :height, :width]
+                native = mapping.native_predictions(field)
+                for index, predicted in zip(chosen, native):
+                    target = targets[index]
+                    prediction = predicted[target.flatten()]
+                    truth = channels[index].values.detach()[target]
+                    predictions[index] = prediction
+                    losses[channels[index].name] = (prediction.float()-truth.float()).square().mean()
+        return Result(torch.stack(list(losses.values())).mean(), losses,
+                      torch.cat([predictions[i] for i in sorted(predictions)]), tuple(targets))
