+"""Proportional sensor interleaving without replacement or changed loss weights."""
+from collections import defaultdict
+import random
+from encoder_v3.shared_mae.data import EpochPlan
+
+
+class ProportionalEpochPlan(EpochPlan):
+    def __init__(self, rows, seed, batch_size):
+        super().__init__(rows, seed, batch_size)
+        self.seed = seed
+        self.epoch = None
+
+    def batch(self, cursor):
+        if cursor < 0:
+            raise ValueError('Negative training cursor')
+        epoch, batch = divmod(cursor, len(self))
+        if epoch != self.epoch:
+            rng = random.Random(self.seed + epoch)
+            groups = defaultdict(list)
+            for row in self.rows.values():
+                groups[row['sensor']].append(row)
+            for rows in groups.values():
+                rng.shuffle(rows)
+            sensors = sorted(groups)
+            counts = {s: len(groups[s]) for s in sensors}
+            used = dict.fromkeys(sensors, 0)
+            order = []
+            total = len(self.rows)
+            for position in range(total):
+                sensor = max((s for s in sensors if used[s] < counts[s]),
+                             key=lambda s: (position+1)*counts[s]/total-used[s])
+                order.append(groups[sensor][used[sensor]])
+                used[sensor] += 1
+            self.epoch, self.order = epoch, order
+        return self.order[batch*self.batch_size:(batch+1)*self.batch_size]
+
+
+def timed_partition(rows, costs):
+    """Frozen device/sensor intercept + native-value slope from paired measurements."""
+    def estimate(row, slot):
+        base, slope = costs[slot][row['sensor']]
+        return base + slope*sum(b['shape'][0]*b['shape'][1] for b in row['bands'])
+    shards, loads = [[], []], [0., 0.]
+    for row in sorted(rows, key=lambda r: max(estimate(r, i) for i in range(2)), reverse=True):
+        slot = min(range(2), key=lambda i: loads[i]+estimate(row, i))
+        shards[slot].append(row)
+        loads[slot] += estimate(row, slot)
+    return shards
